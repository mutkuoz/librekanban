# ──────────────────────────────────────────────────────────────────────────
# librekanban configuration
# Copy this file to `.env` and adjust. Every variable is validated at boot;
# the server fails fast with a readable error if something is missing/invalid.
# ──────────────────────────────────────────────────────────────────────────

# --- Core ---
NODE_ENV=development
# Public URL the app is served from (used for links, cookies, OAuth callbacks).
PUBLIC_URL=http://localhost:3000
# Port the server listens on.
PORT=3000
# Log verbosity: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Auth ---
# REQUIRED: a long random secret. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-a-long-random-string
# Signup mode: open | invite-only | closed
SIGNUP_MODE=open

# --- Social OAuth (optional; leave blank to disable a provider) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database ---
# Default: PostgreSQL. For docker-compose this is set for you.
DATABASE_URL=postgres://librekanban:librekanban@localhost:5432/librekanban
# Run pending migrations automatically on boot (replica-safe via advisory lock).
AUTO_MIGRATE=true

# --- Realtime / scaling (optional) ---
# Set REDIS_URL to fan out realtime events + rate limits across multiple nodes.
# Leave blank for single-node (in-process) operation.
REDIS_URL=

# --- File storage ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/uploads
# S3-compatible (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Email (optional; transactional notifications) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="librekanban <no-reply@example.com>"

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
